+//go:build with_utls
+
+package tls
+
+import (
+	"net"
+	"testing"
+
+	utls "github.com/metacubex/utls"
+)
+
+// Xray-core 26.9.8+ rejects a REALITY ClientHello without X25519MLKEM768 before X25519.
+func TestRealityClientHelloHasMLKEM(t *testing.T) {
+	for _, name := range []string{"", "chrome", "firefox", "edge", "safari", "360", "qq", "ios", "android", "random", "randomized"} {
+		t.Run(name, func(t *testing.T) {
+			id, err := uTLSClientHelloID(name)
+			if err != nil {
+				t.Fatal(err)
+			}
+			conn, peer := net.Pipe()
+			defer conn.Close()
+			defer peer.Close()
+			uConn, err := realityUClient(conn, &utls.Config{ServerName: "example.com", InsecureSkipVerify: true}, id)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !realityHasMLKEMKeyShare(uConn) {
+				t.Fatal("no X25519MLKEM768 key share before X25519")
+			}
+			keys := uConn.HandshakeState.State13.KeyShareKeys
+			if keys == nil || (keys.Ecdhe == nil && keys.MlkemEcdhe == nil) {
+				t.Fatal("no X25519 private key for the REALITY auth key")
+			}
+		})
+	}
+}

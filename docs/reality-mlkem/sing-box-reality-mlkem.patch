+// realityUClient builds the ClientHello that REALITY servers since Xray-core 26.9.8 require:
+// an X25519MLKEM768 key share placed before the optional X25519 one. Fingerprints that do not
+// carry it (firefox, safari, ... in metacubex/utls) fall back to chrome.
+func realityUClient(conn net.Conn, config *utls.Config, id utls.ClientHelloID) (*utls.UConn, error) {
+	uConn := utls.UClient(conn, config, id)
+	err := uConn.BuildHandshakeState()
+	if err != nil {
+		return nil, err
+	}
+	if realityHasMLKEMKeyShare(uConn) {
+		return uConn, nil
+	}
+	uConn = utls.UClient(conn, config, utls.HelloChrome_Auto)
+	err = uConn.BuildHandshakeState()
+	if err != nil {
+		return nil, err
+	}
+	return uConn, nil
+}
+
+func realityHasMLKEMKeyShare(uConn *utls.UConn) bool {
+	for _, extension := range uConn.Extensions {
+		if ks, ok := extension.(*utls.KeyShareExtension); ok {
+			for _, share := range ks.KeyShares {
+				if share.Group == utls.X25519MLKEM768 {
+					return true
+				}
+				if share.Group == utls.X25519 {
+					return false
+				}
+			}
+		}
+	}
+	return false
+}
